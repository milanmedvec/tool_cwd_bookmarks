#!/usr/bin/env bash
set -euo pipefail

DATA="${CWD_DATA_DIR:-$HOME/.local/share/cwd}"
FILE="$DATA/db.data"
FILE_DEFAULT="$DATA/default.data"

bootstrap() {
    mkdir -p "$DATA"
    touch "$FILE"
}

set_default() {
    echo "Set current directory as default ..." >&2
    pwd >"$FILE_DEFAULT"
}

get_default() {
    cat "$FILE_DEFAULT"
}

add() {
    echo "Adding current directory in the pool ..." >&2
    pwd >>"$FILE"
}

load_dirs() {
    mapfile -t DIRS <"$FILE"
}

choose_dir_index() {
    local height=30
    local width=100
    local choice_height=20
    local backtitle="Select directory"
    local title="Select directory"
    local menu="Which directory do you want to enter?"
    local dir_index=1
    local options=()
    local dir

    load_dirs
    if [[ ${#DIRS[@]} -eq 0 ]]; then
        echo "No directory in the pool!" >&2
        exit 2
    fi

    for dir in "${DIRS[@]}"; do
        options+=("$dir_index" "$dir")
        dir_index=$((dir_index + 1))
        if [[ $dir_index -gt $choice_height ]]; then
            break
        fi
    done

    dialog \
        --clear \
        --backtitle "$backtitle" \
        --title "$title" \
        --menu "$menu" \
        "$height" "$width" "$choice_height" \
        "${options[@]}" 2>&1 >/dev/tty
}

remove() {
    local choice
    choice="$(choose_dir_index)" || exit 2

    if [[ -z "$choice" ]]; then
        echo "No directory selected" >&2
        exit 2
    fi

    unset 'DIRS[choice - 1]'
    printf '%s\n' "${DIRS[@]}" >"$FILE"
}

go_to() {
    local choice selected_dir
    choice="$(choose_dir_index)" || exit 2

    if [[ -z "$choice" ]]; then
        echo "No directory selected" >&2
        exit 2
    fi

    selected_dir="${DIRS[choice - 1]}"
    printf '%s\n' "$selected_dir"
}

main() {
    bootstrap

    case "${1:-}" in
        add)
            add
            ;;
        remove)
            remove
            ;;
        set-default)
            set_default
            ;;
        get-default)
            get_default
            ;;
        *)
            go_to
            ;;
    esac
}

main "$@"
