#!/bin/bash

DATA="$HOME/.local/share/cwd"
FILE="${DATA}/db.data"
FILE_DEFAULT="${DATA}/default.data"

set_default() {
    >&2 echo "Set current directory as default ...";
    pwd > $FILE_DEFAULT
}

get_default() {
    cat $FILE_DEFAULT
}

add() {
    >&2 echo "Adding current directory in the pool ...";
    pwd >> $FILE
}

remove() {
    touch $FILE

    DIRS=()
    while read -r line
    do
        DIRS+=("$line");
    done < $FILE

    if [ ${#DIRS[@]} -eq 0 ]
    then
        >&2 echo "No directory in the pool!"
        exit 2
    fi

    HEIGHT=30;
    WIDTH=100;
    CHOICE_HEIGHT=20;
    BACKTITLE="Select directory";
    TITLE="Select directory";
    MENU="Which directory do you want to enter?";
    DIR_INDEX=1;
    OPTIONS=();

    for dir in ${DIRS[@]}
    do
        OPTIONS+=("$DIR_INDEX" "$dir");
        DIR_INDEX=$((DIR_INDEX + 1));
        if [ $DIR_INDEX -gt $CHOICE_HEIGHT ]; then
            break;
        fi
    done;

    CHOICE=$(dialog \
        --clear \
        --backtitle "$BACKTITLE" \
        --title "$TITLE" \
        --menu "$MENU" \
        $HEIGHT $WIDTH $CHOICE_HEIGHT \
        "${OPTIONS[@]}" 2>&1 > /dev/tty
    );

    if [ -z "${CHOICE}" ]
    then
        >&2 echo "No directory selected"
        exit 2
    else
        unset DIRS["$((CHOICE - 1))"]
        echo -n > $FILE
        for dir in ${DIRS[@]}
        do
            echo $dir > $FILE
        done
    fi
}

go_to() {
    touch $FILE

    DIRS=()
    while read -r line
    do
        DIRS+=("$line");
    done < $FILE

    if [ ${#DIRS[@]} -eq 0 ]
    then
        >&2 echo "No directory in the pool!"
        exit 2
    fi

    HEIGHT=30;
    WIDTH=100;
    CHOICE_HEIGHT=20;
    BACKTITLE="Select directory";
    TITLE="Select directory";
    MENU="Which directory do you want to enter?";
    DIR_INDEX=1;
    OPTIONS=();

    for dir in ${DIRS[@]}
    do
        OPTIONS+=("$DIR_INDEX" "$dir");
        DIR_INDEX=$((DIR_INDEX + 1));
        if [ $DIR_INDEX -gt $CHOICE_HEIGHT ]; then
            break;
        fi
    done;

    CHOICE=$(dialog \
        --clear \
        --backtitle "$BACKTITLE" \
        --title "$TITLE" \
        --menu "$MENU" \
        $HEIGHT $WIDTH $CHOICE_HEIGHT \
        "${OPTIONS[@]}" 2>&1 > /dev/tty
    );

    if [ -z "${CHOICE}" ]
    then
        >&2 echo "No directory selected"
        exit 2
    else
        SELECTED_DIR=${DIRS["$((CHOICE - 1))"]}
        echo $SELECTED_DIR
    fi
}

main() {
    case $1 in
        add)
            add
            exit 1
            ;;
        remove)
            remove
            exit 1
            ;;
        set-default)
            set_default
            exit 1
            ;;
        get-default)
            get_default
            exit 1
            ;;
        *)
            go_to
            exit 0
            ;;
    esac
}

main $@
